MODEL_ID = "google/gemma-4-26B-A4B-it"
MODEL_DEVICE = "cuda"
SERVING_ENGINE = "transformers"
# For Linux CUDA with vLLM, set SERVING_ENGINE="vllm" and
# MODEL_ID="nvidia/Gemma-4-26B-A4B-NVFP4". No separate HTTP server is needed.
VLLM_GPU_MEMORY_UTILIZATION = "0.50"
# Optional KV-cache allocation in bytes; blank uses the utilization budget.
# Setting this overrides the utilization budget, not total process memory.
# Example: 4294967296 = 4 GiB; verify capacity for 12,288 tokens on your GPU.
VLLM_KV_CACHE_MEMORY_BYTES = ""
LOG_LEVEL = "INFO"
RETRY_LIMIT = "1"
# IANA timezone used for the date extraction workflow's current-time reference.
ANALYSIS_TIMEZONE = "Europe/Stockholm"
POCKETBASE_URL = "http://127.0.0.1:8090"
# Local LanceDB directory; relative paths resolve against the repository root.
LANCEDB_STORAGE_PATH = "./data/vectordb/"
# PocketBase stays private; registration is anonymous and writes use user sessions.
# Comma-separated browser origins. Add the deployed frontend's exact HTTPS origin.
AUTH_ALLOWED_ORIGINS = "http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000"
# Use true behind production HTTPS; false allows local HTTP development.
AUTH_COOKIE_SECURE = "false"
